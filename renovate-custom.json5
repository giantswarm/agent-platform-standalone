// Repo-specific Renovate rules, extended last by the generated renovate.json5.
{
  // The dependency pins Renovate manages live in curate.yaml: the org preset's
  // customManager matches the `# registry:` hint above each `version:` pin
  // (docker datasource against the chart OCI repos). On a Renovate branch the
  // curate-regen workflow then reruns hack/curate.sh so Chart.yaml, Chart.lock
  // and the chart README follow the bumped pin.
  //
  // Chart.yaml and Chart.lock themselves are generator OUTPUT, so the helm
  // managers stay disabled: a direct Renovate edit there would be overwritten
  // by the next curation run (two bots on Chart.yaml fight).
  helmv3: {
    enabled: false,
  },
  'helm-values': {
    enabled: false,
  },
  // The curate-regen workflow pushes the regenerated files onto every Renovate
  // branch as Taylor Bot. Renovate reads a commit by any author other than
  // itself as a manual edit of the PR: it stops rebasing the branch when a
  // newer release appears and, once main carries the bump by other means,
  // retitles the PR "- abandoned" instead of closing it. Listing the regen
  // author here makes those commits Renovate's own: a rebase drops the regen
  // commit and the workflow recreates it on the rebased branch.
  gitIgnoredAuthors: [
    'dev@giantswarm.io',
  ],
  packageRules: [
    {
      // These registries tag with a `v` prefix (kubectl since 1.33.5: `v1.33.5`,
      // `v1.37.0`; vllm-openai: `v0.28.0`). The org `# registry:` manager keeps
      // that prefix outside its version capture, so the pin in
      // overlay/contract.yaml carries the literal `v` and Renovate sees the
      // digits. Stripping the prefix from the registry's versions as well keeps
      // both sides in the same shape: the replacement turns `v1.37.0` into
      // `v1.37.1`. Without this Renovate writes the tag verbatim, re-extracts
      // the digits, finds them unequal to its new value and aborts the branch
      // with "Error updating branch: update failure" (the kubectl 1.33.4 →
      // v1.37.0 update sat under Errored in the Dependency Dashboard since
      // 2026-09-02), or, for a pin that already carries the `v`, would write
      // `vv1.37.1`.
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'gsoci.azurecr.io/giantswarm/kubectl',
        'docker.io/vllm/vllm-openai',
      ],
      extractVersion: '^v?(?<version>.*)$',
    },
  ],
}
